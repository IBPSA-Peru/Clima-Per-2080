Temp/
Backup/

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Entornos virtuales
venv/
.venv/
env/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/

# Node / NPM
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Firebase (local cache)
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
